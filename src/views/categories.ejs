<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <% if (categories && categories.length > 0) { %>
        <div class="categories-list">
            <ul>
                <% categories.forEach(category => { %>
                    <li><%= category.name %></li>
                <% }) %>
            </ul>
        </div>
    <% } else { %>
        <p>No categories found in the database.</p>
    <% } %>
</main>

<%- include('partials/footer') %>