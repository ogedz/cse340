<%- include('partials/header') %>

<main>
    <% if (organizationDetails) { %>
        <h1><%= organizationDetails.name %></h1>
        
        <div class="organization-details">
            <img src="/images/<%= organizationDetails.logo_filename %>" 
                 alt="<%= organizationDetails.name %> logo" 
                 class="org-detail-logo">
            
            <p><%= organizationDetails.description %></p>
            <p>📧 <a href="mailto:<%= organizationDetails.contact_email %>">
                <%= organizationDetails.contact_email %></a></p>
        </div>

        <h2>Service Projects</h2>
        <% if (projects && projects.length > 0) { %>
            <ul class="org-projects-list">
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        <span class="project-date">📅 <%= project.date %></span>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No projects found for this organization.</p>
        <% } %>

        <div class="organization-actions">
            <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="btn btn-primary">✏️ Edit Organization</a>
            <a href="/organizations" class="btn btn-secondary">← Back to Organizations</a>
        </div>
    <% } else { %>
        <h1>Organization Not Found</h1>
        <p>The organization you are looking for does not exist.</p>
        <p><a href="/organizations" class="btn btn-secondary">← Back to Organizations</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>