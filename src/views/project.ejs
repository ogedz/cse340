<%- include('partials/header') %>

<main>
    <% if (project) { %>
        <h1><%= project.title %></h1>
        
        <div class="project-details">
            <p class="project-description"><%= project.description %></p>
            
            <div class="project-meta">
                <p>📅 <strong>Date:</strong> <%= project.date %></p>
                <p>📍 <strong>Location:</strong> <%= project.location %></p>
                <p>🏢 <strong>Organization:</strong> 
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>
            </div>

            <div class="category-tags">
                <strong>Categories:</strong>
                <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(category => { %>
                        <a href="/category/<%= category.category_id %>" class="category-tag">
                            <%= category.name %>
                        </a>
                    <% }) %>
                <% } else { %>
                    <span>No categories assigned</span>
                <% } %>
            </div>

            <!-- Volunteer Section (only for logged-in users) -->
            <% if (isLoggedIn) { %>
                <div class="volunteer-section">
                    <% if (userIsVolunteer) { %>
                        <p class="volunteer-status">✅ You are volunteering for this project</p>
                        <a href="/project/<%= project.project_id %>/remove-volunteer" class="btn btn-secondary">Remove Me as Volunteer</a>
                    <% } else { %>
                        <a href="/project/<%= project.project_id %>/volunteer" class="btn btn-success">🙋 Volunteer for this Project</a>
                    <% } %>
                </div>
            <% } %>
            
            <div class="project-actions">
                <% if (user && user.role_name === 'admin') { %>
                    <a href="/edit-project/<%= project.project_id %>" class="btn btn-primary">✏️ Edit Project</a>
                    <a href="/assign-categories/<%= project.project_id %>" class="btn btn-primary">🏷️ Edit Categories</a>
                <% } %>
                <a href="/projects" class="btn btn-secondary">← Back to Projects</a>
            </div>
        </div>
    <% } else { %>
        <h1>Project Not Found</h1>
        <p>The project you are looking for does not exist.</p>
        <p><a href="/projects" class="btn btn-secondary">← Back to Projects</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>