<%- include('partials/header') %>

<main>
    <% if (category) { %>
        <h1><%= category.name %></h1>
        
        <h2>Service Projects in this Category</h2>
        
        <% if (projects && projects.length > 0) { %>
            <ul class="category-projects-list">
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        <span class="project-org">— <%= project.organization_name %></span>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No projects found in this category.</p>
        <% } %>
        
        <div class="category-actions">
            <a href="/edit-category/<%= category.category_id %>" class="btn btn-primary">✏️ Edit Category</a>
            <a href="/categories" class="btn btn-secondary">← Back to Categories</a>
        </div>
    <% } else { %>
        <h1>Category Not Found</h1>
        <p><a href="/categories" class="btn btn-secondary">← Back to Categories</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>